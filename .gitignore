# Virtual environments
.venv/
venv/
env/

# Python cache and generated files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local configuration and secrets
.env
.env.*
!.env.example

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated and private data
data/synthetic/*
data/real/*
!data/synthetic/.gitkeep
!data/real/.gitkeep
eval/results/*
!eval/results/.gitkeep

# OCR and image-processing outputs
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
